# AI-generated demo art (optional upgrade over the committed SVGs;
# regenerate with `npm run generate:assets -- --ai`).
# The manifest itself IS committed — seed-data.ts imports it, so a clone
# without it would not build. It ships with an empty `assets` object.
public/generated/*.png
public/generated/*.jpg
public/generated/*.webp

