# ---------------------------------------------------------------------------
# Boop — environment variables
# Copy to `.env.local` and fill in. NEVER commit real values.
# Every variable below is OPTIONAL: with none of them set, Boop runs in
# self-contained Demo Mode (in-memory store + seeded tests + SVG assets).
# ---------------------------------------------------------------------------

# Public site origin. Used for canonical URLs, OG images and share links.
NEXT_PUBLIC_SITE_URL=

# --- Supabase (Postgres + Auth + Storage) ----------------------------------
# Project Settings -> API. Without these, Boop uses the in-memory demo store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — used by the seed script and webhook handlers.
# Must never be prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Public Storage bucket for variant images.
SUPABASE_STORAGE_BUCKET=boop-variants

# --- OpenAI (optional) ------------------------------------------------------
# Used ONLY to summarise human feedback and to generate neutral demo art.
# Without it, results pages show deterministic aggregate statistics instead.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# --- Stripe (optional) ------------------------------------------------------
# Without these, /pricing renders in demo mode and checkout is disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_ENABLED=

# --- Anonymous voting -------------------------------------------------------
# Server-side pepper for one-way hashing of anonymous voter session ids.
# Generate with: openssl rand -hex 32
ANON_HASH_SECRET=
