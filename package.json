{
  "name": "boop",
  "version": "1.0.0",
  "private": true,
  "description": "Boop — Know what people pick before you ship. Human taste tests for builders.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
